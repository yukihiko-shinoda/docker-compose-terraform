// For format details, see https://aka.ms/devcontainer.json. For config options, see the README at:
// https://github.com/microsoft/vscode-dev-containers/tree/v0.154.0/containers/docker-existing-docker-compose
// If you want to run as a non-root user in the container, see .devcontainer/docker-compose.yml.
{
	"name": "Existing Docker Compose (Extend)",
	
	// Update the 'dockerComposeFile' list if you have more compose files or use different names.
	// The .devcontainer/docker-compose.yml file contains any overrides you need/want to make.
	"dockerComposeFile": [
		"../compose.yml",
		"compose.yml"
	],

	// The 'service' property is the name of the service for the container that VS Code should
	// use. Update this value and .devcontainer/docker-compose.yml to the real service name.
	"service": "tenv",

	// The optional 'workspaceFolder' property is the path VS Code should open by default when
	// connected. This is typically a file mount in .devcontainer/docker-compose.yml
	"workspaceFolder": "/workspace",
	
	"initializeCommand": {
		// Runs on the host, before the container is created/rebuilt. Both entries run
		// in parallel (object form), which is fine since they mint unrelated secrets
		// with no dependency on each other:
		// - aws-agent-session.sh: mints a fresh short-lived ReadOnlyAccess session
		//   from the ai_agent IAM role (see iam-role.md) -- so the long-lived key
		//   never enters the container, even via VS Code's own	compose invocation.
		//   Re-mints every run since the session expires.
		"aws-agent-session": "${localWorkspaceFolder}/aws-agent-session.sh",
		// - gcp-agent-key.sh: ensures a static claude-code service account JSON key
		//   exists on the host. Unlike the AWS session, this key never expires, so
		//   the script only creates it once and no-ops on every later run.
		"gcp-agent-key": "${localWorkspaceFolder}/gcp-agent-key.sh",
		// Use the 1Password CLI to generate a .env file with secrets:
		// - Launch a dev container using current process' environment · Issue #9339 · microsoft/vscode-remote-release
		//   https://github.com/microsoft/vscode-remote-release/issues/9339#issuecomment-2227926973
		"1password-inject": "op inject --force --in-file .env.op --out-file .env"
	},
	// Clean up env file generated by the 1Password CLI.
	"postAttachCommand": "rm .env",
	"customizations": {
		"vscode": {
			// Add the IDs of extensions you want installed when the container is created.
			"extensions": [
				"anthropic.claude-code",
				"streetsidesoftware.code-spell-checker",
				"mhutchie.git-graph",
				"eamodio.gitlens",
				"DavidAnson.vscode-markdownlint",
				"redhat.vscode-yaml",
				"hashicorp.hcl",
				"hashicorp.terraform",
				"AquaSecurityOfficial.trivy-vulnerability-scanner",
				"ms-python.python"
			],
			// Set *default* container specific settings.json values on container create.
			"settings": {
				"extensions.autoUpdateDelay": 72,
				"cSpell.customDictionaries": {
					"project-words": {
						"name": "project-words",
						"path": "${workspaceRoot}/project-words.txt",
						"description": "Words used in this project",
						"addWords": true
					}
				},
				"cSpell.diagnosticLevel": "Hint",
				"cSpell.patterns": [
					{
						"name": "terraform.comment.single-line",
						"description": "Matches Terraform single-line comments",
						"pattern": "/(#|\\/\\/).*/g"
					},
					{
						"name": "terraform.comment",
						"description": "Matches Terraform comments",
						"pattern": [
							"CStyleComment",
							"terraform.comment.single-line"
						]
					}
				],
				"cSpell.languageSettings": [
					{
						"languageId": "terraform,tf",
						"includeRegExpList": [
							"terraform.comment"
						]
					}
				],
				"cSpell.overrides": [
					{
						"filename": [
							"*.tf",
							"*.tfvars"
						],
						"languageId": "terraform"
					}
				],
				"cSpell.ignoreWords": [
					"tfvars"
				],
				"cSpell.enabledFileTypes": {
					"tf": true,
					"terraform": true
				},
				"editor.formatOnSave": true,
				"files.associations": {
					"*.tftest.hcl": "terraform"
				},
				"terraform.experimentalFeatures.validateOnSave": true,
				"[terraform]": {
					"editor.defaultFormatter": "hashicorp.terraform",
					"editor.formatOnSave": false,
					"editor.codeActionsOnSave": {
						"source.formatAll.terraform": "explicit"
					}
				},
				"[terraform-vars]": {
					"editor.defaultFormatter": "hashicorp.terraform",
					"editor.formatOnSave": false,
					"editor.codeActionsOnSave": {
						"source.formatAll.terraform": "explicit"
					}
				}
			}
		}
	}
	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// Uncomment the next line if you want start specific services in your Docker Compose config.
	// "runServices": [],

	// Uncomment the next line if you want to keep your containers running after VS Code shuts down.
	// "shutdownAction": "none",

	// Uncomment the next line to run commands after the container is created - for example installing curl.
	// "postCreateCommand": "apt-get update && apt-get install -y curl",

	// Uncomment to connect as a non-root user if you've added one. See https://aka.ms/vscode-remote/containers/non-root.
	// "remoteUser": "vscode"
}
